# Run the Streamlit app with: python -m streamlit run app.py
# mock: local sandbox; live: external ProjectAgain API, GET only
AGENT_MODE=mock

# Real ProjectAgain deployment (host only, NO /api/v1 suffix)
MARKETPLACE_API_URL=
MARKETPLACE_AUTH_SCHEME=bearer
MARKETPLACE_INCLUDE_DEMO=true
# Do not save a shared marketplace token here or in Streamlit Cloud Secrets.
# Each user may enter a short-lived opaque delegation token in the sidebar.
# Legacy MARKETPLACE_API_KEY is ignored in live mode for visitor safety.

# Optional OpenAI tool calling; incurs usage charges if enabled publicly
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ENABLE_OPENAI_CHAT=false
