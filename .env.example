# Run the Streamlit app with: python -m streamlit run app.py
# 매물 데이터는 ProjectAgain HTTPS API만 사용합니다. 별도 Mock 모드는 없습니다.

# Real ProjectAgain deployment (host only, NO /api/v1 suffix)
MARKETPLACE_API_URL=
MARKETPLACE_AUTH_SCHEME=bearer
MARKETPLACE_INCLUDE_DEMO=true
# Do not save a shared marketplace token here or in Streamlit Cloud Secrets.
# v0.18 users sign in using ProjectAgain OIDC. Add [auth] to Streamlit Secrets
# (see docs/OIDC_LOGIN_V018.md); do not store user access tokens in .env.
# Legacy MARKETPLACE_API_KEY is ignored for public visitors.

# Optional OpenAI tool calling; incurs usage charges if enabled publicly
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ENABLE_OPENAI_CHAT=false

# Optional developer-only sidebar diagnostics; keep false for public users.
SHOW_DEVELOPER_TOOLS=false

# Optional: account-scoped persistent memory for Streamlit Cloud.
# Default local SQLite survives local process restart but NOT Cloud redeploy.
# PostgreSQL requires: python -m pip install "psycopg[binary]"
# Store this URL ONLY in environment/Streamlit Secrets, never commit it.
AGENT_STATE_DATABASE_URL=

# Live offer drafts: opt-in ONLY after Replit v0.13 request contract and idempotency are verified.
# Creates pending platform actions after explicit human click; no auto-approve/execute.
ENABLE_LIVE_DRAFTS=false

# AI use in a public Streamlit app (DEFAULT: fail closed without verified identity and shared DB)
# Recommended: reuse the same durable PostgreSQL as AGENT_STATE_DATABASE_URL,
# or put a separate private PostgreSQL URL in AI_USAGE_DATABASE_URL.
AI_USAGE_DATABASE_URL=
AI_CALLS_PER_MINUTE=4
AI_CALLS_PER_USER_DAY=30
AI_GLOBAL_CALLS_PER_DAY=300
AI_USER_DAILY_USD=0.20
AI_GLOBAL_DAILY_USD=2.00
AI_MAX_RESERVED_CALL_USD=0.04
# Pricing defaults only for gpt-4.1-mini. For another model, set both USD/1M rates.
# AI_INPUT_USD_PER_1M=0.40
# AI_OUTPUT_USD_PER_1M=1.60
# ProjectAgain 통합 로그인은 Streamlit Secrets [auth] 및 Authlib가 필요합니다.
# 플랫폼 v0.23 OIDC가 실제 배포되어야 작동합니다.

# v0.18.1 Broker: actual secrets belong in Streamlit Cloud Secrets only.
# PROJECTAGAIN_API_ORIGIN=https://YOUR-PLATFORM-HOST
# PROJECTAGAIN_BROKER_CLIENT_ID=projectagain-streamlit-broker
# PROJECTAGAIN_BROKER_CLIENT_SECRET=SET_IN_SECRET_MANAGER
# PROJECTAGAIN_BROKER_REDIRECT_URL=https://projectagain.streamlit.app/
# AGENT_BROKER_STORE_KEY=SET_FERNET_KEY_IN_SECRET_MANAGER
# AGENT_STATE_DATABASE_URL=postgresql://SET_IN_SECRET_MANAGER

# v0.37 Unified Login (off until Platform v0.37 + 0014 + live E2E are ready).
# v0.19.4: Keep Streamlit Cloud Main file path `app.py`. ASGI launches `chat_ui.py`.
# AGENT_UNIFIED_LOGIN_ENABLED=false
